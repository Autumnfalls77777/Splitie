# ---------------------------------------------------------------------------
# Supabase (safe to expose in the Expo client; protected by RLS)
# ---------------------------------------------------------------------------
# Use the project base URL, not the /rest/v1/ endpoint.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Older projects may use the anon JWT instead of the publishable key.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# PostHog analytics (safe to expose)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Sentry (DSN is public; auth token is build-only and must never be EXPO_PUBLIC_)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=splite
SENTRY_PROJECT=splitie
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Google OAuth is configured in Supabase → Authentication → Providers → Google.
# Do not put the Google client secret in any EXPO_PUBLIC_* variable.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=
